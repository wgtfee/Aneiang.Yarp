@{
    Layout = null;
}
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Industrial Platform Console · 安全中心</title>
    <style>
        :root { color-scheme: light; font-family: Inter, "Segoe UI", sans-serif; background: #f4f7fb; color: #172033; }
        body { margin: 0; } .shell { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
        aside { background: #132238; color: #e7eefb; padding: 24px 16px; } aside h1 { font-size: 18px; margin: 0 8px 28px; }
        aside a, aside button { display:block; width:100%; box-sizing:border-box; border:0; background:transparent; color:#b9c8df; text-align:left; padding:11px 12px; border-radius:8px; cursor:pointer; font-size:14px; margin:3px 0; }
        aside a:hover, aside button.active, aside button:hover { background:#244263; color:#fff; } main { padding: 32px 40px; max-width: 1280px; width:100%; box-sizing:border-box; }
        header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:22px; } h2 { margin:0; font-size:26px; } .muted { color:#6b778c; font-size:13px; }
        .card { background:#fff; border:1px solid #e1e8f1; border-radius:12px; padding:20px; box-shadow:0 5px 20px rgba(29,48,75,.05); } .toolbar { display:flex; gap:10px; align-items:center; margin-bottom:16px; }
        button.primary { background:#1769d2; color:#fff; border:0; border-radius:7px; padding:9px 14px; cursor:pointer; } button.secondary { background:#eef3f9; color:#29405e; border:0; border-radius:7px; padding:9px 14px; cursor:pointer; }
        table { width:100%; border-collapse:collapse; font-size:13px; } th,td { text-align:left; padding:12px 10px; border-bottom:1px solid #edf1f6; vertical-align:top; } th { color:#65748b; font-weight:600; background:#fafbfd; }
        .badge { display:inline-block; border-radius:20px; padding:3px 9px; font-size:12px; background:#e7f6ec; color:#16723b; } .badge.off { background:#fff0f0; color:#ad3030; }
        .notice { padding:12px 14px; background:#fff8e6; color:#7b5a10; border-radius:8px; margin-bottom:16px; display:none; } .error { color:#b42318; }
        .auth-box { margin-top:12px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
        .auth-box input { border:1px solid #d8e1ec; border-radius:7px; padding:8px 10px; min-width:150px; }
        .dialog-backdrop { position:fixed; inset:0; background:rgba(10,25,45,.45); display:none; align-items:center; justify-content:center; padding:20px; z-index:10; }
        .dialog { background:#fff; border-radius:12px; width:min(900px,100%); max-height:90vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.2); }
        .dialog header { padding:20px 24px 12px; margin:0; border-bottom:1px solid #edf1f6; } .dialog-body { padding:18px 24px; overflow:auto; }
        .permission-group { border:1px solid #e5ebf3; border-radius:8px; margin-bottom:12px; overflow:hidden; } .permission-group h3 { margin:0; padding:10px 14px; font-size:14px; background:#f7f9fc; }
        .permission-row { display:flex; gap:10px; align-items:flex-start; padding:9px 14px; border-top:1px solid #edf1f6; font-size:13px; } .permission-row small { color:#748199; margin-left:auto; }
        .resource-tree { border:1px solid #e5ebf3; border-radius:8px; margin-bottom:12px; overflow:hidden; } .resource-tree h3 { margin:0; padding:10px 14px; font-size:14px; background:#f7f9fc; }
        .resource-tree-row { display:flex; gap:10px; align-items:flex-start; padding:9px 14px; border-top:1px solid #edf1f6; font-size:13px; } .resource-tree-row small { color:#748199; margin-left:auto; }
        .tree-toggle { background:transparent; border:0; cursor:pointer; color:#65748b; font-size:11px; padding:11px 4px 11px 10px; line-height:1; flex:0 0 auto; width:20px; text-align:center; border-top:1px solid #edf1f6; }
        .tree-toggle:hover { color:#1769d2; } .tree-toggle-spacer { display:inline-block; width:24px; flex:0 0 auto; border-top:1px solid #edf1f6; }
        .tree-children { margin-left:14px; }
        .form-dialog { width:min(460px,100%); } .confirm-dialog { width:min(420px,100%); } .alert-dialog { width:min(420px,100%); }
        .form-field { display:block; margin-bottom:14px; } .form-label { display:block; font-size:13px; color:#65748b; margin-bottom:6px; font-weight:600; }
        .form-input { width:100%; box-sizing:border-box; border:1px solid #d8e1ec; border-radius:7px; padding:9px 11px; font-size:14px; color:#172033; outline:none; }
        .form-input:focus { border-color:#1769d2; box-shadow:0 0 0 3px rgba(23,105,210,.12); }
        .perm-toolbar { display:flex; gap:8px; align-items:center; margin-bottom:12px; }
        .perm-search { width:280px; max-width:60%; flex:0 1 auto; padding:7px 10px; font-size:13px; }
        .perm-toolbar button { font-size:13px; padding:7px 12px; }
        .confirm-message { margin:6px 0; font-size:14px; color:#29405e; line-height:1.6; white-space:pre-wrap; word-break:break-all; }
        .dialog-footer { padding:14px 24px; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #edf1f6; }
        @@media(max-width:800px){.shell{grid-template-columns:1fr}aside{position:static;display:flex;gap:5px;overflow:auto}aside h1{display:none}aside a,aside button{white-space:nowrap;width:auto}}
    </style>
</head>
<body>
<div class="shell">
    <aside>
        <h1>微服务平台控制台</h1>
        <a href="/platform">← 返回总览</a>
        <button class="active" data-view="users">用户管理</button>
        <button data-view="roles">角色管理</button>
        <button data-view="systems">系统管理</button>
        <button data-view="resources">权限资源</button>
        <button data-view="clients">Client 管理</button>
        <button data-view="migrations">迁移绑定</button>
        <button data-view="audit">审计日志</button>
    </aside>
    <main>
        <header><div><h2 id="title">用户管理</h2><div class="muted">IAM 数据通过 Gateway API 获取，Gateway 不直接访问 IAM 数据库。</div></div><button class="secondary" id="refresh">刷新</button></header>
        <div class="notice" id="authNotice">当前浏览器没有 IAM Access Token。请使用 IAM 账号完成 PKCE 登录。
            <div class="auth-box"><input id="iamUserName" autocomplete="username" placeholder="IAM 用户名" value="admin" /><input id="iamPassword" type="password" autocomplete="current-password" placeholder="IAM 密码" /><button class="primary" id="iamLogin">IAM 登录</button><span class="muted">YARP 登录与 IAM 登录是两套凭据。</span></div>
        </div>
        <div class="card"><div class="toolbar"><span class="muted" id="summary"></span><span class="error" id="error"></span></div><div id="content">加载中…</div></div>
    </main>
</div>
<div class="dialog-backdrop" id="permissionDialog">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="permissionTitle">
        <header><div><h2 id="permissionTitle">角色权限</h2><div class="muted" id="permissionHint"></div></div></header>
        <div class="dialog-body">
            <div class="perm-toolbar">
                <input id="permissionSearch" class="form-input perm-search" placeholder="搜索权限名称 / 编码…" autocomplete="off" />
                <button class="secondary" onclick="expandAllPermissions()">展开全部</button>
                <button class="secondary" onclick="collapseAllPermissions()">收起全部</button>
            </div>
            <div id="permissionBody">加载中…</div>
        </div>
        <div class="dialog-footer"><button class="secondary" onclick="closePermissionDialog()">取消</button><button class="primary" onclick="saveRolePermissions()">保存授权</button></div>
    </div>
</div>
<div class="dialog-backdrop" id="formDialog">
    <div class="dialog form-dialog" role="dialog" aria-modal="true">
        <header><div><h2 id="formDialogTitle">表单</h2><div class="muted" id="formDialogHint"></div></div></header>
        <div class="dialog-body"><div id="formDialogFields"></div><div class="error" id="formDialogError"></div></div>
        <div class="dialog-footer"><button class="secondary" id="formDialogCancel">取消</button><button class="primary" id="formDialogOk">确定</button></div>
    </div>
</div>
<div class="dialog-backdrop" id="confirmDialog">
    <div class="dialog confirm-dialog" role="dialog" aria-modal="true">
        <header><div><h2 id="confirmDialogTitle">确认</h2></div></header>
        <div class="dialog-body"><p class="confirm-message" id="confirmDialogMessage"></p></div>
        <div class="dialog-footer"><button class="secondary" id="confirmDialogCancel">取消</button><button class="primary" id="confirmDialogOk">确定</button></div>
    </div>
</div>
<div class="dialog-backdrop" id="alertDialog">
    <div class="dialog alert-dialog" role="dialog" aria-modal="true">
        <header><div><h2 id="alertDialogTitle">提示</h2></div></header>
        <div class="dialog-body"><p class="confirm-message" id="alertDialogMessage"></p></div>
        <div class="dialog-footer"><button class="primary" id="alertDialogOk">知道了</button></div>
    </div>
</div>
<script>
const labels={users:'用户管理',roles:'角色管理',systems:'系统管理',resources:'权限资源',clients:'Client 管理',migrations:'迁移绑定',audit:'审计日志'};
let view='users';
const token=()=>localStorage.getItem('industrial_access_token')||localStorage.getItem('access_token')||'';
const gatewayClientId='industrial-gateway-web';
function buildTree(items){const byParent=new Map();const known=new Set(items.map(x=>String(x.code)));for(const item of items){const key=item.parentCode&&known.has(String(item.parentCode))?String(item.parentCode):'';if(!byParent.has(key))byParent.set(key,[]);byParent.get(key).push(item);}for(const list of byParent.values())list.sort((a,b)=>(a.sort||0)-(b.sort||0)||String(a.code).localeCompare(String(b.code)));const nodes=new Map();items.forEach(i=>nodes.set(String(i.code),{item:i,children:[]}));const roots=[];for(const item of items){const node=nodes.get(String(item.code));const pk=item.parentCode&&known.has(String(item.parentCode))?String(item.parentCode):'';if(pk&&nodes.has(pk))nodes.get(pk).children.push(node);else roots.push(node);}return roots;}
function toggleTreeNode(btn){const node=btn.closest('.resource-tree-node');if(!node)return;const children=node.querySelector(':scope > .tree-children');if(!children)return;const collapsed=children.style.display==='none';children.style.display=collapsed?'':'none';btn.textContent=collapsed?'▾':'▸';}
function collapsibleTreeHtml(system,items,renderRow,isSelected){const roots=buildTree(items);const expanded=new Set();function hasSelected(node){if(isSelected&&isSelected(String(node.item.code)))return true;return node.children.some(hasSelected);}if(isSelected){(function mark(nodes){for(const n of nodes){if(n.children.length&&hasSelected(n))expanded.add(String(n.item.code));mark(n.children);}})(roots);}function nodeHtml(node,depth){const hasCh=node.children.length>0;const code=String(node.item.code);const isExpanded=expanded.has(code);const toggle=hasCh?'<button class="tree-toggle" data-code="'+esc(code)+'" onclick="event.stopPropagation();toggleTreeNode(this)" title="展开/收起">'+(isExpanded?'▾':'▸')+'</button>':'<span class="tree-toggle-spacer"></span>';const childrenHtml=hasCh?'<div class="tree-children" style="'+(isExpanded?'':'display:none')+'">'+node.children.map(c=>nodeHtml(c,depth+1)).join('')+'</div>':'';return '<div class="resource-tree-node">'+toggle+renderRow(node.item,depth)+childrenHtml+'</div>';}return '<section class="resource-tree"><h3>'+esc(system)+'</h3>'+roots.map(r=>nodeHtml(r,0)).join('')+'</section>';}
const redirectUri=()=>location.origin+'/platform/security/callback';
const baseRender=render;
render=async function(){await baseRender();if(view!=='resources')return;try{const data=await api('/resources');const groups=new Map();for(const item of data.filter(x=>!x.deprecated)){if(!groups.has(item.systemCode))groups.set(item.systemCode,[]);groups.get(item.systemCode).push(item);}document.querySelector('#content').innerHTML=[...groups.entries()].map(([system,items])=>collapsibleTreeHtml(system,items,(item)=>'<div class="resource-tree-row"><span><strong>'+esc(item.name||item.code)+'</strong><br/><small>'+esc(item.code)+' · '+esc(item.type)+' · v'+esc(item.version||item.resourceVersion||'')+'</small></span><small>'+(item.enabled?'Enabled':'Disabled')+'</small></div>',null)).join('')||'<div class="muted">暂无业务系统权限资源，请先同步 Manifest。</div>';}catch(e){document.querySelector('#error').textContent=e.message;}};
let rolePermSelected=new Set();let rolePermGroups=new Map();let rolePermAllSelected=false;
function rolePermMatches(item,kw){return !kw||(item.name||'').toLowerCase().includes(kw)||(item.code||'').toLowerCase().includes(kw);}
function rolePermissionTreeHtml(system,items,kw){const byParent=new Map();const known=new Set(items.map(x=>String(x.code)));for(const item of items){const key=item.parentCode&&known.has(String(item.parentCode))?String(item.parentCode):'';if(!byParent.has(key))byParent.set(key,[]);byParent.get(key).push(item);}for(const list of byParent.values())list.sort((a,b)=>(a.sort||0)-(b.sort||0)||String(a.code).localeCompare(String(b.code)));const nodes=new Map();items.forEach(i=>nodes.set(String(i.code),{item:i,children:[]}));const roots=[];for(const item of items){const node=nodes.get(String(item.code));const pk=item.parentCode&&known.has(String(item.parentCode))?String(item.parentCode):'';if(pk&&nodes.has(pk))nodes.get(pk).children.push(node);else roots.push(node);}const expanded=new Set();function hasSelectedInTree(node){if(rolePermSelected.has(String(node.item.code)))return true;return node.children.some(hasSelectedInTree);}if(kw){(function mark(nodes){for(const n of nodes){if(n.children.some(c=>rolePermMatches(c.item,kw)))expanded.add(String(n.item.code));mark(n.children);}})(roots);}else{(function mark(nodes){for(const n of nodes){if(n.children.length&&hasSelectedInTree(n))expanded.add(String(n.item.code));mark(n.children);}})(roots);}function nodeHtml(node,depth){const hasCh=node.children.length>0;const code=String(node.item.code);const isExpanded=expanded.has(code);const toggle=hasCh?'<button class="tree-toggle" onclick="event.stopPropagation();toggleTreeNode(this)">'+(isExpanded?'▾':'▸')+'</button>':'<span class="tree-toggle-spacer"></span>';const childrenHtml=hasCh?'<div class="tree-children" style="'+(isExpanded?'':'display:none')+'">'+node.children.map(c=>nodeHtml(c,depth+1)).join('')+'</div>':'';const checked=rolePermAllSelected?'disabled':(rolePermSelected.has(code)?'checked':'');return '<div class="resource-tree-node">'+toggle+'<label class="permission-row"><input type="checkbox" data-permission-code="'+esc(code)+'" onchange="onPermissionToggle(this)" '+checked+'/><span>'+esc(node.item.name||code)+'<br/><small>'+esc(code)+' · '+esc(node.item.type)+'</small></span></label>'+childrenHtml+'</div>';}return '<section class="resource-tree"><h3>'+esc(system)+'</h3>'+roots.map(r=>nodeHtml(r,0)).join('')+'</section>';}
function renderRolePermissionTree(kw){const body=document.querySelector('#permissionBody');const groupsHtml=[...rolePermGroups.entries()].map(([system,items])=>{let filtered=items;if(kw){const matched=new Set();const codeToItem=new Map(items.map(it=>[String(it.code),it]));for(const it of items){if(rolePermMatches(it,kw)){matched.add(String(it.code));let cur=it;while(cur&&cur.parentCode&&codeToItem.has(String(cur.parentCode))){matched.add(String(cur.parentCode));cur=codeToItem.get(String(cur.parentCode));}}}filtered=items.filter(it=>matched.has(String(it.code)));}return rolePermissionTreeHtml(system,filtered,kw);}).join('');body.innerHTML='<label class="permission-row" style="border:1px solid #d8e4f2;border-radius:8px;margin-bottom:14px"><input id="permissionAll" type="checkbox" '+(rolePermAllSelected?'checked':'')+' onchange="toggleAllPermissions()"/><span><strong>全部权限 (*)</strong><br/><small>平台管理员等特殊角色可使用；选中后保存为通配权限。</small></span></label>'+(groupsHtml||'<div class="muted">暂无可授权的权限资源，请先同步业务系统 Manifest。</div>');updatePermissionHint();}
function updatePermissionHint(){const count=[...document.querySelectorAll('#permissionBody [data-permission-code]:checked')].length;document.querySelector('#permissionHint').textContent='已选 '+(rolePermAllSelected?'全部权限':count+' 项')+'；保存后相关用户的 PermissionVersion 会递增。';}
function onPermissionToggle(cb){const node=cb.closest('.resource-tree-node');if(!node)return;node.querySelectorAll(':scope > .tree-children [data-permission-code]').forEach(c=>{c.checked=cb.checked;c.indeterminate=false;c.disabled=rolePermAllSelected;});updateAncestors(node);updatePermissionHint();}
function updateAncestors(node){let parent=node.parentElement?node.parentElement.closest('.resource-tree-node'):null;while(parent){const box=parent.querySelector(':scope > .permission-row > input[data-permission-code]');if(!box)break;const direct=[...parent.querySelectorAll(':scope > .tree-children > .resource-tree-node > .permission-row > input[data-permission-code]')];const checkedCount=direct.filter(c=>c.checked).length;if(direct.length&&checkedCount===direct.length){box.checked=true;box.indeterminate=false;}else if(checkedCount===0){box.checked=false;box.indeterminate=false;}else{box.checked=false;box.indeterminate=true;}parent=parent.parentElement?parent.parentElement.closest('.resource-tree-node'):null;}}
function expandAllPermissions(){document.querySelectorAll('#permissionBody .tree-children').forEach(c=>c.style.display='');document.querySelectorAll('#permissionBody .tree-toggle').forEach(b=>b.textContent='▾');}
function collapseAllPermissions(){document.querySelectorAll('#permissionBody .tree-children').forEach(c=>c.style.display='none');document.querySelectorAll('#permissionBody .tree-toggle').forEach(b=>b.textContent='▸');}
openRolePermissions=async function(encodedCode){editingRoleCode=decodeURIComponent(encodedCode);const dialog=document.querySelector('#permissionDialog');const body=document.querySelector('#permissionBody');dialog.style.display='flex';document.querySelector('#permissionTitle').textContent='角色权限：'+editingRoleCode;body.textContent='加载中…';try{const [resources,selected]=await Promise.all([api('/resources'),api('/roles/'+encodeURIComponent(editingRoleCode)+'/permissions')]);rolePermSelected=new Set(selected||[]);rolePermAllSelected=rolePermSelected.has('*');rolePermGroups=new Map();for(const item of resources.filter(x=>x.enabled&&!x.deprecated)){if(!rolePermGroups.has(item.systemCode))rolePermGroups.set(item.systemCode,[]);rolePermGroups.get(item.systemCode).push(item);}const search=document.querySelector('#permissionSearch');if(search)search.value='';renderRolePermissionTree('');}catch(e){body.innerHTML='<div class="error">无法加载权限资源：'+esc(e.message)+'</div>';}};
document.querySelector('#permissionSearch').addEventListener('input',e=>renderRolePermissionTree(e.target.value.trim()));
async function api(path, options={}){const headers=options.headers||{}; if(token()) headers.Authorization='Bearer '+token(); const controller=new AbortController(); const timer=setTimeout(()=>controller.abort(),15000); try{const r=await fetch('/api/iam'+path,{...options,headers,signal:controller.signal}); if(r.status===401||r.status===403) document.querySelector('#authNotice').style.display='block'; if(!r.ok) throw new Error('IAM API '+r.status); return r.status===204?null:r.json();}catch(err){if(err&&err.name==='AbortError')throw new Error('IAM API 请求超时（15 秒），请检查网络或服务状态后重试'); throw err;}finally{clearTimeout(timer);}}
function toBase64Url(bytes){let s='';for(const b of bytes)s+=String.fromCharCode(b);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
async function sha256(value){return new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(value)));}
async function beginIamLogin(){const userName=document.querySelector('#iamUserName').value.trim();const password=document.querySelector('#iamPassword').value;if(!userName||!password){alertDialog('提示','请输入 IAM 用户名和密码。');return;}const button=document.querySelector('#iamLogin');button.disabled=true;try{const login=await fetch('/platform/security/login',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({userName,password})});if(!login.ok)throw new Error('IAM 登录失败（用户名或密码错误）。');document.querySelector('#iamPassword').value='';const bytes=new Uint8Array(32);crypto.getRandomValues(bytes);const verifier=toBase64Url(bytes);const state=toBase64Url(crypto.getRandomValues(new Uint8Array(24)));localStorage.setItem('industrial_pkce_verifier',verifier);localStorage.setItem('industrial_pkce_state',state);const challenge=toBase64Url(await sha256(verifier));const query=new URLSearchParams({client_id:gatewayClientId,response_type:'code',redirect_uri:redirectUri(),scope:'openid profile industrial-platform',code_challenge:challenge,code_challenge_method:'S256',state});location.href='/connect/authorize?'+query.toString();}catch(e){document.querySelector('#error').textContent=e.message;button.disabled=false;}}
async function completePkceLogin(){const query=new URLSearchParams(location.search);const code=query.get('code');if(query.get('error')){document.querySelector('#error').textContent='IAM 授权失败：'+(query.get('error_description')||query.get('error'));return false;}if(!code)return false;const state=query.get('state');if(!state||state!==localStorage.getItem('industrial_pkce_state')){document.querySelector('#error').textContent='IAM 登录状态校验失败，请重新登录。';return false;}const body=new URLSearchParams({grant_type:'authorization_code',client_id:gatewayClientId,code,redirect_uri:redirectUri(),code_verifier:localStorage.getItem('industrial_pkce_verifier')||''});const response=await fetch('/connect/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});if(!response.ok){document.querySelector('#error').textContent='IAM 令牌交换失败（'+response.status+'）。';return false;}const result=await response.json();localStorage.setItem('industrial_access_token',result.access_token);if(result.refresh_token)localStorage.setItem('industrial_refresh_token',result.refresh_token);localStorage.removeItem('industrial_pkce_verifier');localStorage.removeItem('industrial_pkce_state');history.replaceState({},'',location.pathname);return true;}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function table(headers, rows){return `<table><thead><tr>${headers.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows||'<tr><td colspan="8" class="muted">暂无数据</td></tr>'}</tbody></table>`;}
async function render(){document.querySelector('#title').textContent=labels[view];document.querySelector('#error').textContent='';document.querySelector('#content').textContent='加载中…';try{
 let data, rows;
 if(view==='users'){data=await api('/users');rows=data.map(x=>`<tr><td>${esc(x.userName)}</td><td>${esc(x.displayName)}</td><td>${esc(x.tenant)}</td><td>${x.enabled?'<span class="badge">Active</span>':'<span class="badge off">Disabled</span>'}</td><td>${esc(x.permissionVersion)}</td><td>${esc(x.lastLoginAt||'')}</td><td><button class="secondary" onclick="toggleUser('${x.id}',${!x.enabled})">${x.enabled?'禁用':'启用'}</button> <button class="secondary" onclick="editProfile('${x.id}','${encodeURIComponent(x.displayName||'')}','${encodeURIComponent(x.email||'')}','${encodeURIComponent(x.phone||'')}')">资料</button> <button class="secondary" onclick="toggleLockout('${x.id}')">锁定/解锁</button> <button class="secondary" onclick="resetPassword('${x.id}')">重置密码</button> <button class="secondary" onclick="bindUserRoles('${x.id}')">角色绑定</button> <button class="secondary" onclick="setSystemAccess('${x.id}')">系统访问</button> <button class="secondary" onclick="viewUserPermissions('${x.id}')">查看权限</button></td></tr>`);document.querySelector('#content').innerHTML=`<div class="toolbar"><button class="primary" onclick="createUser()">新增用户</button></div>${table(['用户名','显示名','租户','状态','权限版本','最后登录','操作'],rows)}`;}
 if(view==='roles'){data=await api('/roles');rows=data.map(x=>`<tr><td>${esc(x.code)}</td><td>${esc(x.name)}</td><td>${esc(x.description)}</td><td>${x.enabled?'<span class="badge">Enabled</span>':'<span class="badge off">Disabled</span>'}</td><td><button class="secondary" onclick="openRolePermissions('${encodeURIComponent(x.code)}')">权限配置</button> <button class="secondary" onclick="toggleRole('${encodeURIComponent(x.code)}',${!x.enabled})">${x.enabled?'禁用':'启用'}</button></td></tr>`);document.querySelector('#content').innerHTML=`<div class="toolbar"><button class="primary" onclick="createRole()">新增角色</button></div>${table(['编码','名称','说明','状态','操作'],rows)}`;}
 if(view==='systems'){data=await api('/systems');rows=data.map(x=>`<tr><td>${esc(x.code)}</td><td>${esc(x.name)}</td><td>${esc(x.description)}</td><td>${x.enabled?'<span class="badge">Enabled</span>':'<span class="badge off">Disabled</span>'}</td><td>${esc(x.resourceVersion||'')}</td><td>${esc(x.manifestHash||'')}</td><td><button class="secondary" onclick="toggleSystem('${encodeURIComponent(x.code)}',${!x.enabled})">${x.enabled?'禁用':'启用'}</button></td></tr>`);document.querySelector('#content').innerHTML=table(['编码','名称','说明','状态','资源版本','Manifest Hash','操作'],rows);}
 if(view==='resources'){data=await api('/resources');rows=data.map(x=>`<tr><td>${esc(x.systemCode)}</td><td>${esc(x.code)}</td><td>${esc(x.name)}</td><td>${esc(x.type)}</td><td>${esc(x.version)}</td><td>${x.enabled?'Enabled':'Disabled'}</td></tr>`);document.querySelector('#content').innerHTML=table(['系统','编码','名称','类型','版本','状态'],rows);}
 if(view==='clients'){data=await api('/clients');rows=data.map(x=>`<tr><td>${esc(x.clientId)}</td><td>${esc(x.displayName)}</td><td>${esc(x.clientType)}</td><td>${esc(x.scopesJson)}</td><td>${x.enabled?'<span class="badge">Enabled</span>':'<span class="badge off">Disabled</span>'}</td><td><button class="secondary" onclick="toggleClient('${encodeURIComponent(x.clientId)}',${!x.enabled})">${x.enabled?'禁用':'启用'}</button></td></tr>`);document.querySelector('#content').innerHTML=table(['Client ID','名称','类型','Scopes','状态','操作'],rows);}
 if(view==='migrations'){data=await api('/users/migrate/bindings');rows=data.map(x=>`<tr><td>${esc(x.systemCode)}</td><td>${esc(x.localUserId)}</td><td>${esc(x.iamUserId)}</td><td>${esc(x.status)}</td><td>${esc(x.reason||'')}</td><td>${x.status==='Active'?`<button class="secondary" onclick="rollbackBinding('${x.id}')">回滚绑定</button>`:''}</td></tr>`);document.querySelector('#content').innerHTML=`<div class="toolbar"><button class="primary" onclick="createBinding()">新增绑定</button></div>${table(['系统','本地用户','IAM 用户','状态','原因','操作'],rows)}`;}
 if(view==='audit'){data=await api('/audit');rows=data.map(x=>`<tr><td>${esc(x.createdAt)}</td><td>${esc(x.action)}</td><td>${esc(x.objectType)}</td><td>${esc(x.objectId)}</td><td>${esc(x.operatorUserId)}</td></tr>`);document.querySelector('#content').innerHTML=table(['时间','操作','对象类型','对象','操作者'],rows);}
 document.querySelector('#summary').textContent=`${data.length} 条记录`;
 }catch(e){document.querySelector('#error').textContent=e.message;document.querySelector('#content').textContent='无法加载 IAM 数据。';}}
async function toggleUser(id,enabled){try{await api('/users/'+encodeURIComponent(id)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}}
async function editProfile(id,displayName,email,phone){formDialog('编辑用户资料',[{key:'displayName',label:'显示名',value:decodeURIComponent(displayName||'')},{key:'email',label:'邮箱',value:decodeURIComponent(email||'')},{key:'phone',label:'手机号',value:decodeURIComponent(phone||'')}],async(v)=>{try{await api('/users/'+encodeURIComponent(id)+'/profile',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({displayName:v.displayName,email:v.email||null,phone:v.phone||null})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function toggleLockout(id){confirmDialog('锁定/解锁用户','确定锁定该用户？取消将解除锁定。',async()=>{try{await api('/users/'+encodeURIComponent(id)+'/lockout',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({locked:true,minutes:15})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}},async()=>{try{await api('/users/'+encodeURIComponent(id)+'/lockout',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({locked:false})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function createUser(){formDialog('新增用户',[{key:'userName',label:'用户名',required:true,placeholder:'登录账号'},{key:'displayName',label:'显示名'},{key:'password',label:'初始密码（至少 8 位）',type:'password',required:true}],async(v)=>{try{await api('/users',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({userName:v.userName,displayName:v.displayName||v.userName,password:v.password})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function createRole(){formDialog('新增角色',[{key:'code',label:'角色编码',required:true,placeholder:'如 MES_OPERATOR'},{key:'name',label:'角色名称'}],async(v)=>{try{await api('/roles',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:v.code,name:v.name||v.code})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function bindUserRoles(id){try{const roles=await api('/roles');formDialog('绑定角色',[{key:'roleCodes',label:'角色编码（多个用逗号分隔）',required:true,value:roles.map(x=>x.code).join(',')}],async(v)=>{const roleCodes=v.roleCodes.split(',').map(x=>x.trim()).filter(Boolean);try{await api('/users/'+encodeURIComponent(id)+'/roles',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({roleCodes})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}catch(e){document.querySelector('#error').textContent=e.message;}}
async function viewUserPermissions(id){try{const snapshot=await api('/users/'+encodeURIComponent(id)+'/permissions');alertDialog('用户权限', 'PermissionVersion: '+snapshot.version+'\n\n'+((snapshot.permissions||[]).join('\n')||'（无权限）'));}catch(e){document.querySelector('#error').textContent=e.message;}}
async function resetPassword(id){formDialog('重置密码',[{key:'password',label:'新的临时密码（至少 8 位）',type:'password',required:true}],async(v)=>{try{await api('/users/'+encodeURIComponent(id)+'/reset-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:v.password})});alertDialog('提示','密码已重置');}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function setSystemAccess(id){formDialog('系统访问',[{key:'system',label:'系统编码（MES、IoT、WCS、MOL）',required:true,placeholder:'如 MES'}],async(v)=>{confirmDialog('授予系统访问','确定授予 '+v.system+' 系统访问权限？取消将撤销。',async()=>{try{await api('/users/'+encodeURIComponent(id)+'/system-access/'+encodeURIComponent(v.system),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:true})});alertDialog('提示','系统访问已授予');}catch(e){document.querySelector('#error').textContent=e.message;}},async()=>{try{await api('/users/'+encodeURIComponent(id)+'/system-access/'+encodeURIComponent(v.system),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:false})});alertDialog('提示','系统访问已撤销');}catch(e){document.querySelector('#error').textContent=e.message;}});});}
async function toggleRole(encodedCode,enabled){const code=decodeURIComponent(encodedCode);try{await api('/roles/'+encodeURIComponent(code)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}}
async function toggleSystem(encodedCode,enabled){const code=decodeURIComponent(encodedCode);try{await api('/systems/'+encodeURIComponent(code)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}}
async function toggleClient(encodedId,enabled){const id=decodeURIComponent(encodedId);try{await api('/clients/'+encodeURIComponent(id)+'/status',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}}
async function createBinding(){formDialog('新增迁移绑定',[{key:'systemCode',label:'系统编码',required:true,placeholder:'MES、IoT、WCS、MOL'},{key:'localUserId',label:'本地用户 ID',required:true},{key:'iamUserId',label:'IAM 用户 ID',required:true},{key:'reason',label:'迁移原因',value:'Local→Platform'}],async(v)=>{try{await api('/users/migrate/bindings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({systemCode:v.systemCode,localUserId:v.localUserId,iamUserId:v.iamUserId,reason:v.reason})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});}
async function rollbackBinding(id){formDialog('回滚绑定',[{key:'reason',label:'回滚原因',required:true,value:'纠正身份绑定'}],async(v)=>{confirmDialog('确认回滚','确定回滚该绑定？',async()=>{try{await api('/users/migrate/bindings/'+encodeURIComponent(id)+'/rollback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:v.reason})});await render();}catch(e){document.querySelector('#error').textContent=e.message;}});});}
function formDialog(title, fields, onSubmit){const backdrop=document.getElementById('formDialog');document.getElementById('formDialogTitle').textContent=title;document.getElementById('formDialogHint').textContent='';document.getElementById('formDialogError').textContent='';document.getElementById('formDialogFields').innerHTML=fields.map(f=>'<label class="form-field"><span class="form-label">'+esc(f.label)+'</span><input class="form-input" id="fld_'+esc(f.key)+'" type="'+(f.type||'text')+'" value="'+esc(f.value??'')+'" placeholder="'+esc(f.placeholder||'')+'" autocomplete="off" /></label>').join('');backdrop.style.display='flex';const first=document.querySelector('#formDialogFields input');if(first)first.focus();const ok=document.getElementById('formDialogOk');const cancel=document.getElementById('formDialogCancel');const close=()=>{backdrop.style.display='none';ok.onclick=null;cancel.onclick=null;document.onkeydown=null;};const submit=()=>{const values={};for(const f of fields){const el=document.getElementById('fld_'+f.key);const v=el?el.value.trim():'';if(f.required&&!v){document.getElementById('formDialogError').textContent=f.label+' 不能为空';el&&el.focus();return;}values[f.key]=v;}close();onSubmit(values);};ok.onclick=submit;cancel.onclick=close;document.onkeydown=(e)=>{if(e.key==='Enter'){e.preventDefault();submit();}else if(e.key==='Escape')close();};}
function confirmDialog(title,message,onOk,onCancel){const backdrop=document.getElementById('confirmDialog');document.getElementById('confirmDialogTitle').textContent=title;document.getElementById('confirmDialogMessage').textContent=message;backdrop.style.display='flex';const ok=document.getElementById('confirmDialogOk');const cancel=document.getElementById('confirmDialogCancel');const close=()=>{backdrop.style.display='none';ok.onclick=null;cancel.onclick=null;document.onkeydown=null;};ok.onclick=()=>{close();onOk&&onOk();};cancel.onclick=()=>{close();onCancel&&onCancel();};document.onkeydown=(e)=>{if(e.key==='Escape')close();};}
function alertDialog(title,message){const backdrop=document.getElementById('alertDialog');document.getElementById('alertDialogTitle').textContent=title;document.getElementById('alertDialogMessage').textContent=message;backdrop.style.display='flex';const ok=document.getElementById('alertDialogOk');const close=()=>{backdrop.style.display='none';ok.onclick=null;document.onkeydown=null;};ok.onclick=close;document.onkeydown=(e)=>{if(e.key==='Escape'||e.key==='Enter')close();};}
let editingRoleCode='';
function toggleAllPermissions(){rolePermAllSelected=document.querySelector('#permissionAll')?.checked===true;document.querySelectorAll('#permissionBody [data-permission-code]').forEach(x=>{x.disabled=rolePermAllSelected;if(rolePermAllSelected){x.checked=false;x.indeterminate=false;}});updatePermissionHint();}
async function saveRolePermissions(){if(!editingRoleCode)return;const codes=document.querySelector('#permissionAll')?.checked?['*']:[...document.querySelectorAll('[data-permission-code]:checked')].map(x=>x.dataset.permissionCode);try{await api('/roles/'+encodeURIComponent(editingRoleCode)+'/permissions',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissionCodes:codes})});closePermissionDialog();await render();alertDialog('提示','角色权限已保存，相关用户将在下一次权限版本检查时刷新。');}catch(e){document.querySelector('#error').textContent=e.message;}}
function closePermissionDialog(){document.querySelector('#permissionDialog').style.display='none';editingRoleCode='';}
document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-view]').forEach(x=>x.classList.remove('active'));b.classList.add('active');view=b.dataset.view;render();});document.querySelector('#refresh').onclick=render;document.querySelector('#iamLogin').onclick=beginIamLogin;
(async()=>{try{const exchanged=await completePkceLogin();if(!token())document.querySelector('#authNotice').style.display='block';await render();if(exchanged)document.querySelector('#authNotice').style.display='none';}catch(e){document.querySelector('#error').textContent=e.message;document.querySelector('#authNotice').style.display='block';}})();
</script>
</body>
</html>
