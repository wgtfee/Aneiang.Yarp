{
  "ReverseProxy": {
    "Routes": {
      "iot-api": {
        "AuthorizationPolicy": "Anonymous"
      },
      "wcs-api": {
        "AuthorizationPolicy": "Anonymous"
      },
      "thinggateway-api": {
        "AuthorizationPolicy": "Anonymous"
      },
      "im-api": {
        "ClusterId": "im",
        "Order": -20,
        "AuthorizationPolicy": "gateway",
        "Match": {
          "Path": "/api/im/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "im": {
        "HealthCheck": {
          "Active": {
            "Enabled": true
          }
        }
      }
    }
  }
}
