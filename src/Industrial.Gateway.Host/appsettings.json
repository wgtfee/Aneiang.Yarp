{
  "Urls": "http://localhost:5202",
  "Iam": {
    "Authority": "http://localhost:5100",
    "Audience": "industrial-platform"
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "platform",
      "Locale": "zh-CN",
      "AuthMode": "None",
      "EnablePassiveHealthCheck": true,
      "PassiveHealthCheckPolicy": "TransportFailureRate",
      "PassiveHealthCheckReactivationPeriod": "00:00:30",
      "HealthHistoryRetentionDays": 30
    },
    "Deployment": {
      "HealthCheck": {
        "Enabled": true,
        "Path": "/healthz",
        "LivePath": "/health/live",
        "ReadyPath": "/health/ready",
        "CheckConfigLoaded": true,
        "CheckDatabase": true
      }
    },
    "Storage": {
      "Sqlite": {
        "ConnectionString": "Data Source=gateway-store.db"
      }
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:5173",
        "http://localhost:8080",
        "http://localhost:9990",
        "http://localhost:27915"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "iam-connect": {
        "ClusterId": "iam",
        "Match": { "Path": "/connect/{**catch-all}" }
      },
      "iam-account": {
        "ClusterId": "iam",
        "Match": { "Path": "/account/{**catch-all}" }
      },
      "iam-discovery": {
        "ClusterId": "iam",
        "Match": { "Path": "/.well-known/{**catch-all}" }
      },
      "iam-api": {
        "ClusterId": "iam",
        "AuthorizationPolicy": "gateway",
        "Order": 10,
        "Match": { "Path": "/api/iam/{**catch-all}" }
      },
      "mes-api": {
        "ClusterId": "mes",
        "AuthorizationPolicy": "gateway",
        "Order": 20,
        "Match": { "Path": "/api/mes/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/mes" }, { "PathPrefix": "/api" }]
      },
      "mes-auth-captcha": {
        "ClusterId": "mes",
        "Order": 1,
        "Match": { "Path": "/api/User/getVierificationCode" }
      },
      "mes-auth-login": {
        "ClusterId": "mes",
        "Order": 2,
        "Match": { "Path": "/api/user/login" }
      },
      "mes-api-default": {
        "ClusterId": "mes",
        "AuthorizationPolicy": "gateway",
        "Order": 1000,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "iot-api": {
        "ClusterId": "iot",
        "AuthorizationPolicy": "gateway",
        "Order": 30,
        "Match": { "Path": "/api/iot/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/iot" }, { "PathPrefix": "/api" }]
      },
      "wcs-api": {
        "ClusterId": "wcs",
        "AuthorizationPolicy": "gateway",
        "Order": 40,
        "Match": { "Path": "/api/wcs/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/wcs" }, { "PathPrefix": "/api" }]
      },
      "thinggateway-api": {
        "ClusterId": "thinggateway",
        "AuthorizationPolicy": "gateway",
        "Order": 50,
        "Match": { "Path": "/api/thinggateway/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/thinggateway" }]
      },
      "im-websocket-platform": {
        "ClusterId": "im",
        "Order": 60,
        "Match": { "Path": "/im/ws/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/im" }]
      },
      "im-websocket-legacy": {
        "ClusterId": "im",
        "Order": 61,
        "Match": { "Path": "/ws/{**catch-all}" }
      },
      "mes-frontend": {
        "ClusterId": "mes-web",
        "Order": 100,
        "Match": { "Path": "/mes/{**catch-all}" }
      },
      "mes-static": {
        "ClusterId": "mes-web",
        "Order": 90,
        "Match": { "Path": "/static/{**catch-all}" }
      },
      "iot-frontend": {
        "ClusterId": "iot-web",
        "Order": 100,
        "Match": { "Path": "/iot/{**catch-all}" }
      },
      "wcs-frontend": {
        "ClusterId": "wcs",
        "Order": 100,
        "Match": { "Path": "/wcs/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/wcs" }]
      },
      "thinggateway-frontend": {
        "ClusterId": "thinggateway",
        "Order": 100,
        "Match": { "Path": "/thinggateway/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/thinggateway" }]
      }
    },
    "Clusters": {
      "iam": {
        "Metadata": { "service": "iam", "healthRole": "backend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "iam-primary": { "Address": "http://localhost:5100/" }
        }
      },
      "mes": {
        "Metadata": { "service": "mes", "healthRole": "backend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "mes-primary": { "Address": "http://localhost:9991/" }
        }
      },
      "mes-web": {
        "Metadata": { "service": "mes-web", "healthRole": "frontend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/mes/index.html"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "mes-web-primary": { "Address": "http://localhost:9990/" }
        }
      },
      "iot": {
        "Metadata": { "service": "iotsharp", "healthRole": "backend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "iot-primary": { "Address": "http://localhost:5002/" }
        }
      },
      "iot-web": {
        "Metadata": { "service": "iotsharp-web", "healthRole": "frontend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/iot/index.html"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "iot-web-primary": { "Address": "http://localhost:27915/" }
        }
      },
      "wcs": {
        "Metadata": { "service": "wcs-eng", "healthRole": "backend", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "wcs-primary": { "Address": "http://localhost:5003/" }
        }
      },
      "thinggateway": {
        "Metadata": {
          "service": "thinggateway",
          "healthRole": "device-gateway",
          "deviceHealthSeparate": "true",
          "slot": "blue"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "thinggateway-primary": { "Address": "http://localhost:5000/" }
        }
      },
      "im": {
        "Metadata": { "service": "im", "healthRole": "realtime", "slot": "blue" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/traffic"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "im-primary": { "Address": "http://localhost:6001/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
